# training outputs (weights) at the repo root only; evaluation evidence in reports/runs/ is committed
/runs/
.unsloth-pins.txt
unsloth_compiled_cache/

# GPU logs written at the repo root by the runbook (`den publish --logs` bundles them); the H100 check is in reports/gpu/
/*.log
/overfit-lora.json
.DS_Store
